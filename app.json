{
  "expo": {
    "name": "Climaps",
    "slug": "climaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/climaps-icon.png",
    "scheme": "climaps",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#204FFF",
    "primaryColor": "#204FFF",
    "ios": {
      "icon": "./assets/images/climaps-icon.png",
      "backgroundColor": "#204FFF",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização apenas para descobrir onde você está e consultar o clima dessa região."
      }
    },
    "android": {
      "package": "com.joseefernandes.climaps",
      "icon": "./assets/images/climaps-icon.png",
      "backgroundColor": "#204FFF",
      "adaptiveIcon": {
        "backgroundColor": "#204FFF",
        "foregroundImage": "./assets/images/climaps-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/climaps-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#204FFF",
          "image": "./assets/images/climaps-horizontal.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#204FFF",
            "image": "./assets/images/climaps-horizontal.png"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ReadexPro_400Regular.ttf",
            "./assets/fonts/ReadexPro_500Medium.ttf",
            "./assets/fonts/ReadexPro_600SemiBold.ttf",
            "./assets/fonts/ReadexPro_700Bold.ttf"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13415565-cf82-418c-881e-9ff08b4daa7d"
      }
    },
    "owner": "josee-fernandes"
  }
}
