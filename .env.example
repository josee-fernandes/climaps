# Copy this file to .env.local and fill in the value:
#   cp .env.example .env.local
#
# Then restart Metro (`npx expo start`) and reload the app.
# Only EXPO_PUBLIC_* vars are available in JS. They are inlined into
# the client bundle, so this key is visible to anyone who inspects the app.

# Request at https://carto.com/basemaps/apikey/ (emailed immediately).
EXPO_PUBLIC_CARTO_API_KEY=

# --- Local (Expo Go / emulator / web) ---
# .env.local is gitignored and loaded automatically by Expo CLI.

# --- Preview / production (EAS Build) ---
# .env.local is NOT uploaded. Set the same variable on EAS, then build:
#
#   eas env:set --name EXPO_PUBLIC_CARTO_API_KEY --value SUA_KEY \
#     --environment preview --visibility sensitive
#
# Repeat with --environment development and --environment production,
# or create once in the dashboard and tick all three environments.
#
# Or: expo.dev → project Climaps → Environment variables
#
# eas.json already maps:
#   development profile → development env
#   preview profile     → preview env
#   production profile  → production env
#
# Build examples:
#   eas build --profile preview --platform android
#   eas build --profile production --platform android
